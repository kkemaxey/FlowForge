# Copy to backend/.env and fill in. Never commit .env or service-account JSON files.
# docker-compose.yml loads this file into both the db and backend containers.

# --- MySQL container (read by the mysql:8.0 image on first start) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=flowforge
MYSQL_USER=flowforge
MYSQL_PASSWORD=change-me
# Separate database for pytest, created by docker/mysql/init/01-test-database.sh
MYSQL_TEST_DATABASE=flowforge_test

# --- Backend ---
# "db" is the MySQL service name inside Docker. From your Mac (outside Docker) use 127.0.0.1.
DATABASE_URL=mysql+pymysql://flowforge:change-me@db:3306/flowforge
TEST_DATABASE_URL=mysql+pymysql://flowforge:change-me@db:3306/flowforge_test

# Seconds between background assigner passes. The loop itself is switched on in
# docker-compose.yml (ASSIGNER_LOOP_ENABLED) and off in tests.
ASSIGNER_INTERVAL_SECONDS=2

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Path to the Firebase service-account JSON. Auth is disabled for the MVP; leave empty.
FIREBASE_CREDENTIALS=
