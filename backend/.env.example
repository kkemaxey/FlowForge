# Copy to .env and fill in. Never commit .env or service-account JSON files.

# Local default is SQLite so the app runs with no setup.
# Cloud SQL (MySQL): mysql+pymysql://USER:PASSWORD@HOST:3306/flowforge
DATABASE_URL=sqlite:///./flowforge.db

# Comma-separated origins allowed to call the API (the Vercel domain in production).
CORS_ORIGINS=http://localhost:3000

# Path to the Firebase service-account JSON. Leave empty on Cloud Run to use
# the service's default credentials.
FIREBASE_CREDENTIALS=

# --- Seed data (python -m app.modules.simulation.cli seed) ---
# Defaults: seed 480, 10x10 grid (45 locations), 25 SKUs (3 low stock), 5 workers, 5 robots. CLI flags override these.
# SEED_RANDOM_SEED=480
# SEED_GRID_WIDTH=10
# SEED_GRID_HEIGHT=10
# SEED_SKUS=25
# SEED_LOW_STOCK_SKUS=3
# SEED_WORKERS=5
# SEED_ROBOTS=5
# Only needed to --reset a non-SQLite database. Never set this against production.
# FLOWFORGE_ALLOW_RESET=1

# Firebase logins the seed creates. Use throwaway values locally; never commit real ones.
SUPERVISOR_EMAIL=
SUPERVISOR_PASSWORD=
SIM_EMAIL=
SIM_PASSWORD=

# --- Simulator and order generator (cli run / orders / trigger) ---
# They sign in as SIM_EMAIL with the Firebase web API key (Firebase console > Project settings).
FIREBASE_WEB_API_KEY=
SIM_API_URL=http://localhost:8000
# SIM_TICK_SECONDS=1
# SIM_WORKER_SPEED=1
# SIM_PICK_SECONDS=5
# SIM_P_STOCKOUT=0.02
# SIM_P_JAM=0.01
# SIM_P_WORKER_DOWN=0.005
# SIM_SEED=7
# SIM_ORDERS_PER_MIN=6
# SIM_WORKER_RECOVERY_SECONDS=30
