# Copy this file to .env and fill in real values.
# NEVER commit .env or the Firebase service-account JSON to git.

# Local demo default is SQLite (no setup needed). For production use Cloud SQL:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/flowforge
DATABASE_URL=sqlite:///./flowforge.db

# true = accept local fake tokens for demos; MUST be false in production.
DEV_MODE=true

# Path to the Firebase service-account credentials (used when DEV_MODE=false).
FIREBASE_CREDENTIALS=/secrets/firebase-service-account.json

# Comma-separated emails that get the supervisor role.
SUPERVISOR_EMAILS=maria@flowforge.example
