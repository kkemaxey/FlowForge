# Copy to backend/.env and fill in real values. Never commit .env.
# URL-encode any @ : / or % inside the password.

# Used by docker compose to create the local MySQL database and app user
MYSQL_DATABASE=flowforge
MYSQL_USER=flowforge_app
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too

# Read by the API
DATABASE_URL=mysql+pymysql://flowforge_app:replace-me@127.0.0.1:3306/flowforge
LOG_LEVEL=INFO

# Optional: run the integration tests against MySQL instead of SQLite (name must contain "test")
# TEST_DATABASE_URL=mysql+pymysql://root:replace-me-too@127.0.0.1:3306/flowforge_test
