# Copy to .env and replace the placeholder values. Never commit .env.
# If a password contains @ : / or %, URL-encode it inside DATABASE_URL.

# Used by docker compose to create the MySQL database and app user
MYSQL_DATABASE=flowforge
MYSQL_USER=flowforge_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Used when running uvicorn directly on your machine against the compose MySQL.
# For a quick start with no MySQL at all: DATABASE_URL=sqlite:///./flowforge.db
DATABASE_URL=mysql+pymysql://flowforge_app:change-me@127.0.0.1:3306/flowforge

LOG_LEVEL=INFO
GRID_WIDTH=20
GRID_HEIGHT=12
